{
  "name": "kamkhadze-pa",
  "version": "1.0.0",
  "description": "Kamkhadze PA — Case Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kamkhadze.pa.casemanager",
    "productName": "Kamkhadze PA",
    "copyright": "Copyright © 2025 Kamkhadze PA",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!node_modules"] },
      { "from": "../case-manager.html", "to": "case-manager.html" },
      { "from": "../case-manager.css",  "to": "case-manager.css"  },
      { "from": "../case-manager.js",   "to": "case-manager.js"   },
      { "from": "../case-manager-auth.js", "to": "case-manager-auth.js" },
      { "from": "../case-manager-v2.js",  "to": "case-manager-v2.js"  },
      { "from": "../backend-adapter.js",  "to": "backend-adapter.js"  }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
